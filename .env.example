# --- PostgreSQL ---
POSTGRES_USER=econ
POSTGRES_PASSWORD=econ
POSTGRES_DB=econintel
DATABASE_URL=postgresql+psycopg://econ:econ@postgres:5432/econintel

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_dev_password

# --- OpenSearch ---
OPENSEARCH_URL=http://opensearch:9200

# --- Data sources ---
# SEC requires a declared User-Agent: "app-name your-name email". Change this!
SEC_USER_AGENT=economic-intelligence-os dev contact@example.com
# Get a free key at https://api.open.fec.gov/developers/ (DEMO_KEY works, low rate limits)
FEC_API_KEY=DEMO_KEY

# --- AI layer (optional; /api/ask degrades gracefully without it) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# --- Platform ---
# Protects POST /api/ingest/run (used by n8n schedules). Empty = open (dev only).
INGEST_API_KEY=change-me
CORS_ORIGINS=http://localhost:5173
DEFAULT_TICKERS=AAPL,MSFT,LMT,XOM,JPM

# --- Frontend ---
VITE_API_URL=http://localhost:8000
